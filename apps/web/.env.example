NODE_ENV=development

# ─── Durable backend (server-side only — NEVER prefix with NEXT_PUBLIC_) ───────
#
# Base URL of the API the /api/runtime/* proxy forwards to.
# For local dev this is the Fastify API running on port 4000.
RUNTIME_API_URL=http://127.0.0.1:4000

# Operator API key the proxy injects as X-Api-Key on every upstream request.
# Required whenever the backend runs with AUTH_ENABLED=true (production + local).
# Lives only in the Next.js server runtime — it NEVER reaches the browser bundle.
#
# How to generate:
#   1. Start Postgres: docker compose up -d postgres
#   2. Run: node apps/api/scripts/seed-operator-key.mjs
#   3. Copy the printed key (starts with sk_local_op_...) and paste it below.
RUNTIME_API_KEY=

# ─── Human authentication (Google Sign-In) ───────────────────────────────────
#
# Session HMAC secret used by the edge middleware to verify the session cookie
# that the API mints. MUST be >=32 chars and MUST match SESSION_SECRET in
# apps/api/.env. The same value is used on both sides for verification.
#
# Generate a strong secret: openssl rand -base64 48
# Leave blank or use the insecure default for local dev (non-production only).
SESSION_SECRET=dev-insecure-session-secret-change-me-please-32+chars

# Google OAuth client id for the "Continue with Google" button.
# This value is PUBLIC by design (it is the OAuth audience, not a secret key).
# MUST match GOOGLE_CLIENT_ID in apps/api/.env.
#
# How to get one:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Web application credential
#   3. Add http://localhost:3000 to Authorized JavaScript origins
#   4. Add http://localhost:3000/auth/callback to Authorized redirect URIs
#   5. Paste the Client ID below
#
# Leave blank to disable Google Sign-In (the "Continue with Google" button
# will not appear and auth will fall back to API key only).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Optional: Analytics / monitoring ────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
