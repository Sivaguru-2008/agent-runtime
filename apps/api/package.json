{
  "name": "@agent-platform/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "predev": "node ../../scripts/free-api.mjs",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workerProcess.ts",
    "kill:api": "node ../../scripts/free-api.mjs",
    "start:supervised": "node ../../scripts/supervisor.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/workerProcess.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.json --noEmit --noUncheckedIndexedAccess --exactOptionalPropertyTypes",
    "ci:reliability": "vitest run test/reliability",
    "ci:invariants": "vitest run test/invariants",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:bench": "INTEGRATION_RUN_BENCH=1 vitest run --config vitest.integration.config.ts test/integration/postgres/benchmarks.integration.test.ts",
    "chaos:run": "vitest run --config vitest.chaos.config.ts",
    "chaos:phase1": "vitest run --config vitest.chaos.config.ts test/chaos/phase1-redis.chaos.test.ts",
    "chaos:phase2": "vitest run --config vitest.chaos.config.ts test/chaos/phase2-postgres.chaos.test.ts",
    "chaos:phase3": "vitest run --config vitest.chaos.config.ts test/chaos/phase3-worker.chaos.test.ts",
    "chaos:phase4": "vitest run --config vitest.chaos.config.ts test/chaos/phase4-sse.chaos.test.ts",
    "chaos:phase5": "vitest run --config vitest.chaos.config.ts test/chaos/phase5-load-shedding.chaos.test.ts",
    "chaos:certify": "vitest run --config vitest.chaos.config.ts test/chaos/phase6-certification.chaos.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.52.1",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "testcontainers": "^10.13.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.4"
  }
}
