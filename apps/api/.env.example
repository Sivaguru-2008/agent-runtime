NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://agents:agents@localhost:5432/agents_runtime
REDIS_URL=redis://localhost:6379
EVENT_BUS_DRIVER=memory
EVENT_STORE_DRIVER=memory
OTEL_SERVICE_NAME=agent-runtime-api
LOG_LEVEL=info

# ─── Phase 1: Real AI Execution ──────────────────────────────────────────────
#
# MODEL_PROVIDER controls which LLM backend executes tasks.
#
#   "deterministic"  — no API key needed; safe for local dev and tests.
#                      Returns static, seeded outputs. DEFAULT.
#   "claude"         — Anthropic Claude (recommended for production).
#                      Requires ANTHROPIC_API_KEY.
#   "openai"         — OpenAI GPT models.
#                      Requires OPENAI_API_KEY.
#   "ollama"         — Local Ollama daemon (privacy-preserving).
#                      Requires a running Ollama instance at OLLAMA_URL.
#
MODEL_PROVIDER=deterministic

# Override the default model name per provider.
# claude  → claude-sonnet-4-6   (if unset)
# openai  → gpt-4o              (if unset)
# ollama  → llama3              (if unset)
# MODEL_NAME=claude-sonnet-4-6

# Cloud provider API keys. Required only for the matching MODEL_PROVIDER.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Per-attempt timeout for provider calls in milliseconds.
PROVIDER_TIMEOUT_MS=120000

# Number of retry attempts for transient errors (rate-limits, 5xx, network).
PROVIDER_MAX_RETRIES=3

# ─── Tool registry ────────────────────────────────────────────────────────────
#
# web.search — defaults to DuckDuckGo Instant Answer (free, no key).
# Set BRAVE_API_KEY to use Brave Search for richer results.
# BRAVE_API_KEY=BSA...

# file.read — sandboxed to FILE_READ_BASE_PATH. Defaults to process.cwd().
# FILE_READ_BASE_PATH=/safe/data/directory
FILE_READ_MAX_BYTES=32768

# web.search HTTP timeout in milliseconds.
TOOL_WEB_SEARCH_TIMEOUT_MS=10000

# code.execute vm sandbox wall-clock timeout in milliseconds.
TOOL_CODE_EXECUTE_TIMEOUT_MS=5000

# ─── Ollama (used when MODEL_PROVIDER=ollama or by LiveExecutionEngine) ───────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_REQUEST_TIMEOUT_MS=120000

# ─── Phase 5: Security & Production Readiness ─────────────────────────────────
#
# AUTH_ENABLED must be 'true' in production. The server refuses to start with
# NODE_ENV=production and AUTH_ENABLED=false.
#
AUTH_ENABLED=false

# Comma-separated paths that bypass authentication. /health is always skipped.
# Add /metrics here if your Prometheus scraper cannot send API keys.
AUTH_SKIP_PATHS=/metrics

# How long a validated API key is cached in Redis (seconds).
# Longer = fewer Postgres hits; shorter = faster revocation propagation.
API_KEY_CACHE_TTL_SEC=300

# Enable Redis sliding-window rate limiting. Requires REDIS_URL.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT_RPM=1000
RATE_LIMIT_WINDOW_MS=60000

# Enable structured audit logging to the audit_log Postgres table.
# Requires PERSISTENCE_DRIVER=postgres.
AUDIT_LOG_ENABLED=false

# Enable per-tenant quota enforcement (executions/hour, concurrent executions).
# Requires REDIS_URL and DATABASE_URL.
QUOTA_ENABLED=false

# How long to wait for in-flight connections to drain on SIGTERM before
# force-exiting. Must be less than Kubernetes terminationGracePeriodSeconds.
SHUTDOWN_DRAIN_TIMEOUT_MS=30000

# ─── Production example (copy + fill in secrets) ─────────────────────────────
# NODE_ENV=production
# DATABASE_URL=postgres://agents:REDACTED@db.internal:5432/agents_runtime
# REDIS_URL=redis://cache.internal:6379
# EVENT_BUS_DRIVER=redis-streams
# EVENT_STORE_DRIVER=postgres
# PERSISTENCE_DRIVER=postgres
# RUNTIME_MODE=distributed
# AUTH_ENABLED=true
# AUTH_SKIP_PATHS=/metrics
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT_RPM=1000
# AUDIT_LOG_ENABLED=true
# QUOTA_ENABLED=true
# MODEL_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-REDACTED
# SHUTDOWN_DRAIN_TIMEOUT_MS=25000
