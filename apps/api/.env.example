NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://agents:agents@localhost:5432/agents_runtime

# Postgres TLS mode. Local Docker Postgres has no TLS → leave unset/disable.
# Managed Postgres (Neon, Supabase, Render, Fly, Aurora) REQUIRES TLS, or the
# boot probe (SELECT 1) fails and a production process exits(2). For a hosted
# deploy set DATABASE_SSL=require.
#   (unset)|false|disable  → no TLS (local Docker)
#   require|no-verify      → TLS, skip CA verification (most managed providers)
#   verify-full|strict     → TLS, verify the CA chain (needs a pinned CA)
DATABASE_SSL=disable

REDIS_URL=redis://localhost:6379
EVENT_BUS_DRIVER=memory
EVENT_STORE_DRIVER=memory
OTEL_SERVICE_NAME=agent-runtime-api
LOG_LEVEL=info

# ─── Phase 1: Real AI Execution ──────────────────────────────────────────────
#
# MODEL_PROVIDER controls which LLM backend executes tasks.
#
#   "deterministic"  — no API key needed; safe for local dev and tests.
#                      Returns static, seeded outputs. DEFAULT.
#   "claude"         — Anthropic Claude (recommended for production).
#                      Requires ANTHROPIC_API_KEY.
#   "openai"         — OpenAI GPT models.
#                      Requires OPENAI_API_KEY.
#   "groq"           — Groq (OpenAI-compatible, very low latency).
#                      Requires GROQ_API_KEY.
#   "failover"        — Try an ordered chain of the above providers, advancing
#                      to the next on a transient failure or OPEN circuit.
#                      Configure the order with MODEL_FAILOVER_CHAIN; links
#                      whose API key is missing are skipped. Put "deterministic"
#                      last to guarantee the runloop always completes even when
#                      every cloud provider is unreachable. RECOMMENDED for a
#                      resilient demo: a Groq outage degrades instead of 500ing.
#
MODEL_PROVIDER=deterministic

# Ordered failover chain, used only when MODEL_PROVIDER=failover.
# Example: keep Groq primary but never hard-fail on a Groq outage.
# MODEL_FAILOVER_CHAIN=groq,deterministic

# Override the default model name per provider.
# claude  → claude-sonnet-4-6        (if unset)
# openai  → gpt-4o                   (if unset)
# groq    → llama-3.3-70b-versatile  (if unset)
# MODEL_NAME=claude-sonnet-4-6

# Cloud provider API keys. Required only for the matching MODEL_PROVIDER.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# Per-attempt timeout for provider calls in milliseconds.
PROVIDER_TIMEOUT_MS=120000

# Number of retry attempts for transient errors (rate-limits, 5xx, network).
PROVIDER_MAX_RETRIES=3

# ─── LLM response cache ───────────────────────────────────────────────────────
# Memoise deterministic (temperature=0) completions keyed by prompt hash so
# identical re-runs / retries / duplicate traffic don't re-bill the provider.
# Off by default; safe to enable for deterministic workloads (pure spend/latency
# win). In-process TTL+LRU today; swap in a Redis-backed ResponseCacheStore for
# multi-node hit sharing.
LLM_RESPONSE_CACHE_ENABLED=false
# Entry lifetime in ms (default 15 minutes).
LLM_RESPONSE_CACHE_TTL_MS=900000
# Max retained entries before LRU eviction (in-process store).
LLM_RESPONSE_CACHE_MAX_ENTRIES=1000

# ─── Tool registry ────────────────────────────────────────────────────────────
#
# web.search — defaults to DuckDuckGo Instant Answer (free, no key).
# Set BRAVE_API_KEY to use Brave Search for richer results.
# BRAVE_API_KEY=BSA...

# file.read — sandboxed to FILE_READ_BASE_PATH. Defaults to process.cwd().
# FILE_READ_BASE_PATH=/safe/data/directory
FILE_READ_MAX_BYTES=32768

# web.search HTTP timeout in milliseconds.
TOOL_WEB_SEARCH_TIMEOUT_MS=10000

# code.execute runs in a permission-jailed child Node process (no filesystem,
# no network, no child processes, no secrets). Wall-clock timeout (ms):
TOOL_CODE_EXECUTE_TIMEOUT_MS=5000
# V8 heap ceiling for the code.execute sandbox child (MB). OOM kills only the
# child, never the API host.
TOOL_CODE_EXECUTE_MEMORY_MB=128

# Strict tool allowlist (comma-separated). When set, ONLY these tools may run;
# every other tool the model requests (incl. via prompt injection) is denied.
# Empty = capability baseline (tools classified UNSAFE are always denied).
# Recommended production posture:
# TOOL_ALLOWLIST=web.search,file.read,code.execute,memory.summarize,runtime.inspect

# ─── Groq (used when MODEL_PROVIDER=groq or by the LiveExecutionEngine) ───────
# Groq is OpenAI-compatible. Supported models:
#   llama-3.3-70b-versatile (default), llama-3.1-8b-instant,
#   deepseek-r1-distill-llama-70b, qwen-qwq-32b
# GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REQUEST_TIMEOUT_MS=120000

# ─── Phase 5: Security & Production Readiness ─────────────────────────────────
#
# AUTH_ENABLED must be 'true' in production. The server refuses to start with
# NODE_ENV=production (or STRICT_PROD=true) and AUTH_ENABLED=false — both
# loadConfig and the auth plugin reject this combination.
#
AUTH_ENABLED=false

# Comma-separated paths that bypass authentication. /health is always skipped.
# Add /metrics here if your Prometheus scraper cannot send API keys.
AUTH_SKIP_PATHS=/metrics

# Role granted to the synthetic tenant when AUTH_ENABLED=false (dev/test only).
# One of: owner | admin | operator | developer | auditor | viewer.
# Defaults to "developer" — the previous behaviour granted "admin" to every
# unauthenticated caller, which this hardening removes. Set to "operator" only
# if you need the operator dashboard in a local unauthenticated run.
# AUTH_DISABLED_FALLBACK_ROLE=developer

# How long a validated API key is cached in Redis (seconds).
# Longer = fewer Postgres hits; shorter = faster revocation propagation.
API_KEY_CACHE_TTL_SEC=300

# Enable Redis sliding-window rate limiting. Requires REDIS_URL.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_DEFAULT_RPM=1000
RATE_LIMIT_WINDOW_MS=60000

# Enable structured audit logging to the audit_log Postgres table.
# Requires PERSISTENCE_DRIVER=postgres.
AUDIT_LOG_ENABLED=false

# Enable per-tenant quota enforcement (executions/hour, concurrent executions).
# Requires REDIS_URL and DATABASE_URL.
QUOTA_ENABLED=false

# ─── Self-serve onboarding (POST /signup) ────────────────────────────────────
# Public endpoint that mints a least-privilege `developer` API key + a fresh
# `starter` tenant, with no operator in the loop. OFF by default — set
# SIGNUP_ENABLED=true to open the activation funnel. Requires DATABASE_URL.
SIGNUP_ENABLED=false
# When false (default) a valid invite code is required; set true for open beta.
SIGNUP_OPEN=false
# Comma-separated invite codes accepted when SIGNUP_OPEN=false. Hand one to each
# design partner so they self-onboard in <60s.
SIGNUP_INVITE_CODES=
# Plan + per-key rate limit stamped on self-serve keys (bounded against abuse).
SIGNUP_DEFAULT_PLAN=starter
SIGNUP_DEFAULT_RPM=120

# ─── Human authentication (Google Sign-In + founder dashboard) ───────────────
# Master switch for the human-session surface: POST /auth/google (signup+login),
# /auth/* (onboarding), and /admin/founder/* (dashboard + user directory).
# OFF by default. Requires DATABASE_URL. In production also requires a strong
# SESSION_SECRET and GOOGLE_CLIENT_ID (loadConfig refuses to boot otherwise).
USER_AUTH_ENABLED=false
# Google OAuth client id — the audience the ID token is verified against. Create
# one at https://console.cloud.google.com/apis/credentials (Web application).
# The SAME value must be set as NEXT_PUBLIC_GOOGLE_CLIENT_ID in apps/web/.env.
GOOGLE_CLIENT_ID=
# HMAC secret used to sign/verify human session tokens. MUST be >=32 chars in
# production and MUST match SESSION_SECRET in apps/web/.env (the edge middleware
# verifies the cookie with it). Generate: `openssl rand -base64 48`.
SESSION_SECRET=
# Human session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Comma-separated emails granted founder access to /admin/founder/* (the founder
# dashboard + user directory). Everyone else gets 403 there.
FOUNDER_EMAILS=

# How long to wait for in-flight connections to drain on SIGTERM before
# force-exiting. Must be less than Kubernetes terminationGracePeriodSeconds.
SHUTDOWN_DRAIN_TIMEOUT_MS=30000

# ─── Production example (copy + fill in secrets) ─────────────────────────────
# NODE_ENV=production
# DATABASE_URL=postgres://agents:REDACTED@db.internal:5432/agents_runtime
# REDIS_URL=redis://cache.internal:6379
# EVENT_BUS_DRIVER=redis-streams
# EVENT_STORE_DRIVER=postgres
# PERSISTENCE_DRIVER=postgres
# RUNTIME_MODE=distributed
# AUTH_ENABLED=true
# AUTH_SKIP_PATHS=/metrics
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT_RPM=1000
# AUDIT_LOG_ENABLED=true
# QUOTA_ENABLED=true
# MODEL_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-REDACTED
# SHUTDOWN_DRAIN_TIMEOUT_MS=25000
