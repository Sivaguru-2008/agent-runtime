\@writefile{toc}{\contentsline {section}{\numberline {S13}Schema-richness ladder}{8}{section.13}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S18}{\ignorespaces Weak-judge transition: Gaussian noise added to the primary judge's scores (calibration and test alike, so exchangeability is preserved). As separation degrades the safe fixed-threshold region collapses, while the conformal threshold rises and keeps realised wrong suppression below $\alpha $ by suppressing less.}}{9}{table.18}\protected@file@percent }
\newlabel{tab:s12b}{{S18}{9}{Weak-judge transition: Gaussian noise added to the primary judge's scores (calibration and test alike, so exchangeability is preserved). As separation degrades the safe fixed-threshold region collapses, while the conformal threshold rises and keeps realised wrong suppression below $\alpha $ by suppressing less}{table.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S19}{\ignorespaces Schema-richness ladder: one act family declared with zero, four and six typed attributes. The residual and the judge's jurisdiction shrink together. L1\_loose ($n=32$) reaches the 19 pairs needed to certify $\alpha =0.05$ at $m=1$, but its threshold falls at a score of 1.00, which the strict inequality never exceeds; L2\_moderate ($n=12$) and L3\_strict ($n=4$) are below it, so $t_{\mathrm  {hi}}=+\infty $. The calibrated layer therefore suppresses nothing at any level.}}{9}{table.19}\protected@file@percent }
\newlabel{tab:s13}{{S19}{9}{Schema-richness ladder: one act family declared with zero, four and six typed attributes. The residual and the judge's jurisdiction shrink together. L1\_loose ($n=32$) reaches the 19 pairs needed to certify $\alpha =0.05$ at $m=1$, but its threshold falls at a score of 1.00, which the strict inequality never exceeds; L2\_moderate ($n=12$) and L3\_strict ($n=4$) are below it, so $\thi =+\infty $. The calibrated layer therefore suppresses nothing at any level}{table.19}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S14}Refinement decomposition}{9}{section.14}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S20}{\ignorespaces Refinement decomposition. The size-only counterfactual draws 5,000 random subsets of the declared pool at the refined pool's size and recomputes the threshold; ``$P(\le $ observed$)$'' is the share of those draws whose deduplication is at most the observed refined value.}}{9}{table.20}\protected@file@percent }
\newlabel{tab:s14}{{S20}{9}{Refinement decomposition. The size-only counterfactual draws 5,000 random subsets of the declared pool at the refined pool's size and recomputes the threshold; ``$P(\le $ observed$)$'' is the share of those draws whose deduplication is at most the observed refined value}{table.20}{}}
