\@writefile{toc}{\contentsline {section}{\numberline {S4}Judge coverage, admission and abstention}{2}{section.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces Judge coverage and the admission rule (coverage $\ge $ 80\%, at least two distinct score values, AUC $\ge $ 0.60). AUC is computed over all scored pairs. Failed clauses are abbreviated: \emph  {coverage} (too few pairs scored to calibrate or to measure), \emph  {resolution} (fewer than two distinct score values), \emph  {signal} (no scored SAME/DIFF overlap, so discrimination is unmeasurable). Exact permutation tests (20,000 permutations) find no association between the Qwen judge's abstentions and any stratification.}}{2}{table.2}\protected@file@percent }
\newlabel{tab:s4a}{{S2}{2}{Judge coverage and the admission rule (coverage $\ge $ 80\%, at least two distinct score values, AUC $\ge $ 0.60). AUC is computed over all scored pairs. Failed clauses are abbreviated: \emph {coverage} (too few pairs scored to calibrate or to measure), \emph {resolution} (fewer than two distinct score values), \emph {signal} (no scored SAME/DIFF overlap, so discrimination is unmeasurable). Exact permutation tests (20,000 permutations) find no association between the Qwen judge's abstentions and any stratification}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces Abstention homogeneity for the Qwen judge (25 abstentions among 1066 pairs), by exact permutation test.}}{2}{table.3}\protected@file@percent }
