\@writefile{lot}{\contentsline {table}{\numberline {S17}{\ignorespaces Threshold sweep on the residual test split. The ``best safe fixed'' threshold is selected using test labels and is therefore not available to a deployment; the bootstrap columns compare the conformal rule with a cross-validated fixed threshold over 500 resamples.}}{8}{table.17}\protected@file@percent }
\newlabel{tab:s12a}{{S17}{8}{Threshold sweep on the residual test split. The ``best safe fixed'' threshold is selected using test labels and is therefore not available to a deployment; the bootstrap columns compare the conformal rule with a cross-validated fixed threshold over 500 resamples}{table.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S18}{\ignorespaces Weak-judge transition: Gaussian noise added to the primary judge's scores (calibration and test alike, so exchangeability is preserved). As separation degrades the safe fixed-threshold region collapses, while the conformal threshold rises and keeps realised wrong suppression below $\alpha $ by suppressing less.}}{9}{table.18}\protected@file@percent }
