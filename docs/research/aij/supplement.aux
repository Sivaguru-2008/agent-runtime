\@writefile{lot}{\contentsline {table}{\numberline {S25}{\ignorespaces Worst case over $\mathcal  {Q}_{n,m}$ (Theorem~2) against the Bonferroni bound $m\rho /(n+1)$, at $\alpha =0.05$. The value in parentheses is the worst case of the threshold one rank lower. The simulation column is the attaining law simulated directly (200,000 draws per row); the gap column is exact and negative entries below $10^{-12}$ are rounding.}}{15}{table.25}\protected@file@percent }
\newlabel{tab:s21}{{S25}{15}{Worst case over $\mathcal {Q}_{n,m}$ (Theorem~2) against the Bonferroni bound $m\rho /(n+1)$, at $\alpha =0.05$. The value in parentheses is the worst case of the threshold one rank lower. The simulation column is the attaining law simulated directly (200,000 draws per row); the gap column is exact and negative entries below $10^{-12}$ are rounding}{table.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S26}{\ignorespaces Beyond the budget ($m>\alpha (n+1)$): the worst case of the most conservative finite threshold, the pool maximum, at $\alpha =0.05$. Every entry exceeds $\alpha $, so no finite scale-free threshold is valid. The grid check covers every $n+1\le 10^6$ at $\alpha =0.05$ and $\alpha =0.01$ (0 exceptions at $\alpha =0.05$, 0 exceptions at $\alpha =0.01$).}}{16}{table.26}\protected@file@percent }
\newlabel{tab:s21b}{{S26}{16}{Beyond the budget ($m>\alpha (n+1)$): the worst case of the most conservative finite threshold, the pool maximum, at $\alpha =0.05$. Every entry exceeds $\alpha $, so no finite scale-free threshold is valid. The grid check covers every $n+1\le 10^6$ at $\alpha =0.05$ and $\alpha =0.01$ (0 exceptions at $\alpha =0.05$, 0 exceptions at $\alpha =0.01$)}{table.26}{}}
